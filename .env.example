DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombreDB
DB_USER=nombreUsuario
DB_PASSWORD=password
PORT=8081
CAS_URL=http://localhost:8080/

KC_DB_NAME=NombreDBKeycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=password

RESEND_API_KEY=tu-api-key

GEMINI_API_KEYS=clave1,clave2,clave3

# S3 local (SeaweedFS del docker-compose). En producción se usa el S3 real y estas variables se definen en el despliegue.
S3_ENDPOINT=http://localhost:8333
S3_REGION=eu-west-1
BUCKET_NAME=pdfs
AWS_ACCESS_KEY_ID=localaccesskey
AWS_SECRET_ACCESS_KEY=localsecretkey

